root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
	 
# Swift Source Files
[*.swift]
indent_style = space
indent_size = 4
max_line_length = 120
	 
[*.{pbxproj,xcworkspacedata,xcscheme}]
indent_style = space
indent_size = 4
	 

[{Podfile,Cartfile,Fastfile,Appfile}]
indent_style = space
indent_size = 2
	 
[*.{md,yml,yaml,json,plist}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
