#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/.swift-format"

# swift-format ships inside the Xcode toolchain (Xcode 16+), so use that copy
# rather than a standalone install to stay in sync with Xcode's built-in formatter.
if ! xcrun --find swift-format &> /dev/null; then
    echo "Error: swift-format is not available."
    echo "It ships with Xcode 16 or newer. Check with: xcrun --find swift-format"
    exit 1
fi

# Retrieve staged Swift files (excluding deleted files and ensuring they exist on disk)
FILES=()
while IFS= read -r -d '' file; do
    if [ -f "$file" ]; then
        FILES+=("$file")
    fi
done < <(git diff --cached --name-only --diff-filter=d -z "*.swift")

if [ ${#FILES[@]} -gt 0 ]; then
    echo "Running swift-format on staged Swift files..."
    xcrun swift-format format --in-place --configuration "$CONFIG" "${FILES[@]}"
    git add "${FILES[@]}"
fi

exit 0
